<!DOCTYPE html><html lang=en><meta charset=UTF-8><meta content="width=device-width,initial-scale=1"name=viewport><title>Security Verification</title><style>:root{--bg-color:#f4f5f7;--card-bg:#ffffff;--text-main:#111827;--text-muted:#6b7280;--border-color:#e5e7eb;--backdrop-tint:rgba(123, 123, 123, 0.4)}@media (prefers-color-scheme:dark){:root{--bg-color:#0f172a;--card-bg:#1e293b;--text-main:#f8fafc;--text-muted:#94a3b8;--border-color:#334155;--backdrop-tint:rgba(15, 23, 42, 0.7)}}body{background-color:var(--bg-color);color:var(--text-main);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif,"Apple Color Emoji","Segoe UI Emoji","Segoe UI Symbol";display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0;padding:20px;box-sizing:border-box}#backdrop-image{position:fixed;inset:0;z-index:-2;background-size:cover;background-position:top center;background-repeat:no-repeat}#backdrop-tint{position:fixed;inset:0;z-index:-1;background-color:var(--backdrop-tint);-webkit-backdrop-filter:blur(6.5px);backdrop-filter:blur(6.5px)}.challenge-container{background-color:var(--card-bg);padding:40px 40px 20px 40px;border-radius:16px;box-shadow:0 25px 50px -12px rgba(0,0,0,.4),0 12px 24px -8px rgba(0,0,0,.25);text-align:center;max-width:480px;width:100%;border:1px solid var(--border-color)}.domain-pill{display:inline-flex;align-items:center;gap:12px;background-color:var(--bg-color);padding:8px 24px 8px 12px;border-radius:50px;margin-bottom:24px;border:1px solid var(--border-color)}.site-favicon{width:28px;height:28px;border-radius:50%;display:none}.site-hostname{font-size:1.1rem;font-weight:600;letter-spacing:.5px}h1{font-size:1.3rem;margin:0 0 10px 0;font-weight:700}p{color:var(--text-muted);font-size:.95rem;margin:0 0 30px 0;line-height:1.5}.cf-wrapper{display:flex;flex-direction:column;justify-content:center;align-items:center;margin-bottom:20px}.cf-wrapper *{margin:0}.support-footer{border-top:1px solid var(--border-color);padding-top:20px;font-size:.85rem;color:var(--text-muted)}.support-toggle{cursor:pointer;list-style:none}.support-toggle::-webkit-details-marker{display:none}.support-toggle-link{color:var(--text-muted);text-decoration:underline}.support-toggle:hover .support-toggle-link{color:var(--text-main)}.diagnostic-data{margin-top:15px;padding:20px;background-color:var(--bg-color);border-radius:8px;text-align:center}.action-buttons{display:flex;gap:10px;justify-content:center;margin-bottom:10px;flex-wrap:wrap}.btn-support{display:inline-block;background-color:#22c55e;color:#fff;text-decoration:none;padding:10px 20px;border-radius:6px;font-weight:600;font-size:.9rem;transition:background-color .2s;border:none;cursor:pointer}.btn-support:hover{background-color:#16a34a}.btn-secondary{background-color:transparent;color:var(--text-main);border:1px solid var(--border-color)}.btn-secondary:hover{background-color:var(--border-color);color:var(--text-main)}.diag-text{font-size:.75rem;color:var(--text-muted);margin:0;line-height:1.4}.diag-raw{text-align:left;font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:.75rem;background:rgba(0,0,0,.05);padding:10px;border-radius:6px;margin-bottom:15px;word-break:break-all}@media (prefers-color-scheme:dark){.diag-raw{background:rgba(255,255,255,.05)}}</style><div id=backdrop-image aria-hidden=true></div><div id=backdrop-tint aria-hidden=true></div><div class=challenge-container><div class=domain-pill><img alt="Site Icon" class=site-favicon id=dynamic-favicon src="data:text/html; charset=utf-8;base64,"> <span id=dynamic-hostname class=site-hostname>::HOST::</span></div><h1>Performing security verification</h1><p>This website uses a security service to protect against malicious bots. This page is displayed while the website verifies you are not a bot.<div class=cf-wrapper><div class="main-wrapper" role="main"><div class="main-content"><noscript><div class="h2"><span id="challenge-error-text">Enable JavaScript and cookies